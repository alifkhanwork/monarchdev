# Local dev: point at Express on port 5000
# Production (Vercel): leave unset — browser uses same-origin /api/* via vercel.json rewrites
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Sentry (browser). Prefer a public DSN restricted to this origin.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
