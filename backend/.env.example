# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/monarchdev?retryWrites=true&w=majority

# Local calendar / daily reset timezone (00:00 here clears dailies)
APP_TIMEZONE=Asia/Manila

# Local dev only (Vercel sets PORT automatically)
PORT=5000

# Public app URL (used in weekly digest email CTA)
APP_URL=https://thedevmonarch.vercel.app

# Resend transactional email (add the same keys in Vercel → Project → Settings → Environment Variables)
RESEND_API_KEY=
DIGEST_FROM_EMAIL=The Dev Monarch <onboarding@resend.dev>

# Protects /api/cron/* — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Sentry error monitoring (optional — leave blank to disable)
SENTRY_DSN=

# Journal field-level encryption (AES-256-GCM). Required for /api/journals.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Add the same value in Vercel → Project → Settings → Environment Variables.
# Losing this key makes existing journal ciphertext unreadable — back it up offline.
JOURNAL_ENCRYPTION_KEY=
